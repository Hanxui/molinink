{# 墨林 - Molinink · 作者 Kira · https://www.molinink.com #}
{# 搜索结果页(既有规范;版式照搜索结果-设计稿 / 设计稿)。title_html/excerpt_html 由 Searcher::highlight 生成:先转义后包 mark,无注入面 #}
<!DOCTYPE html>
<html lang="{{ html_lang() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if keyword %}{{ __('搜索「%s」', 'theme', keyword) }}{% else %}{{ __('搜索', 'theme') }}{% endif %} · {{ site.name }}</title>
    {% if not site.public %}<meta name="robots" content="noindex,nofollow">{% endif %}
    {% include 'partials/theme-style.twig' %}
    {{ inline_style('shell.css') }}
    {{ inline_style('search.css') }}
    {{ head_output }}
</head>
<body>
<div class="page">
    {% include 'partials/site-header.twig' %}

    <main class="site-main">
        <section class="head">
            <div class="eyebrow">{{ __('搜索', 'theme') }}</div>
            <h1>{% if keyword %}{{ keyword }}{% else %}{{ __('搜索', 'theme') }}{% endif %}</h1>
            <div class="underline"></div>
            <div class="tally">{% if keyword %}{{ __('找到 %s 篇结果 · 用时 %s 秒', 'theme', total, (ms / 1000)|number_format(2)) }}{% else %}{{ __('输入关键词，按回车搜索。', 'theme') }}{% endif %}</div>
        </section>

        <form class="search" method="get" action="{{ path('search') }}">
            <label class="vh" for="q">{{ __('搜索关键词', 'theme') }}</label>
            <input id="q" name="q" type="search" value="{{ keyword }}" placeholder="{{ __('输入关键词', 'theme') }}" autocomplete="off">
            <button class="btn" type="submit">{{ __('搜索', 'theme') }}</button>
        </form>

        {% if keyword %}
            {% if items is empty %}
                {# 无结果态(既有规范源件设计稿):一句结论 + 三条建议;分类/归档落点内核给不了就不出 #}
                <section class="empty">
                    <p class="msg">{{ __('没有匹配「%s」的文章。整段关键词与标题、摘要、正文逐字比对，不做中文分词。', 'theme', keyword) }}</p>
                    <div class="suggest">
                        <div class="lab">{{ __('可以试试', 'theme') }}</div>
                        <ul>
                            <li><a href="#q">{{ __('换个更短的关键词，只留两个字', 'theme') }}</a></li>
                            {% if suggest_category is defined and suggest_category %}<li><a href="{{ suggest_category }}">{{ __('去分类页，按栏目找', 'theme') }}</a></li>{% endif %}
                            {% if suggest_date is defined and suggest_date %}<li><a href="{{ suggest_date }}">{{ __('看归档，按月翻旧文', 'theme') }}</a></li>{% endif %}
                        </ul>
                    </div>
                </section>
            {% else %}
                <section class="index">
                    {% for item in items %}
                        <article class="item">
                            <div class="num">{{ item.num }}</div>
                            <div>
                                <h2><a href="{{ item.url }}">{{ item.title_html|raw }}</a></h2>
                                <div class="meta"><span class="dt-long">{{ item.published_at|date(__('Y 年 n 月 j 日', 'theme')) }}</span><span class="dt-short">{{ item.published_at|date('Y.m.d') }}</span> · {{ __('%s 条评论', 'theme', item.comments) }}</div>
                                {% if item.excerpt_html %}<p class="excerpt">{{ item.excerpt_html|raw }}</p>{% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </section>

                {% if pager.pages|length > 1 %}
                    <nav class="pages">
                        {% if pager.prev %}<a href="{{ pager.prev }}">← {{ __('上一页', 'theme') }}</a>{% endif %}
                        {% for p in pager.pages %}<a{% if p.current %} class="cur"{% endif %} href="{{ p.url }}">{{ p.n }}</a>{% endfor %}
                        {% if pager.next %}<a href="{{ pager.next }}">{{ __('下一页', 'theme') }} →</a>{% endif %}
                        <div class="spacer"></div>
                        <div class="count"><span class="c-full">{{ pager.count }}</span><span class="c-comp">{{ pager.count_compact }}</span></div>
                    </nav>
                {% endif %}
            {% endif %}
        {% endif %}
    </main>

    {% include 'partials/footer.twig' %}
</div>
<script src="{{ asset('shell.js') }}" defer></script>
{{ footer_output }}
</body>
</html>
