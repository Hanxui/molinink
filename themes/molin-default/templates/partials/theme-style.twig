{# 墨林 - Molinink · 作者 Kira · https://www.molinink.com #}
{# 主题配色/布局/字体变量(《36》§5):取值经主题设置器回退,没配过也有合理默认;色值已过 #RRGGBB 校验。
   布局宽度、正文字族、正文字号、自定义 CSS 也在此落到 CSS 变量与内联样式 —— 配了就有,不配回退默认。 #}
<style>
  :root {
    --ink: {{ theme_setting('colors.ink') }};
    --paper: {{ theme_setting('colors.paper') }};
    --accent: {{ theme_setting('colors.accent') }};
    {# 次要文字的灰:原 #85837E 在纸色上只有 3.62:1,13px 小字读着发虚;压到与后台 admin.css 同一档 #6E6C67(约 4.6:1) #}
    --muted: #6E6C67;
    --rule: #E5E3DE;
    --ink-soft: #2A2B2E;
    --font-serif: "Noto Serif SC","Source Han Serif SC","Songti SC",SimSun,Georgia,serif;
    --font-sans: "Inter","Helvetica Neue",Arial,"Microsoft YaHei",sans-serif;
    --font-mono: "JetBrains Mono","SFMono-Regular",Consolas,monospace;
    {# 内容宽度:默认「中」即参考图 1480px,换窄/换宽都跟着走 #}
    --content-width: {% if theme_setting('layout.width', 'medium') == 'narrow' %}1080px{% elseif theme_setting('layout.width', 'medium') == 'wide' %}1760px{% else %}1480px{% endif %};
    --font-body: {% if theme_setting('fonts.body', 'serif') == 'sans' %}var(--font-sans){% else %}var(--font-serif){% endif %};
    --font-size: {{ theme_setting('fonts.size', 17) }}px;
  }
  body { font-family: var(--font-body); font-size: var(--font-size); }
  .page { max-width: var(--content-width); }
  {# 页脚挂件区那套 `.footer-widgets` 样式随挂件功能一起删了(2026-10-25) #}
  {# 自定义 CSS 原样输出(代码字段仅管理员可配,《36》§9);断掉 `</`,防样式块被提前闭合 #}
  {{ theme_setting('code.css')|replace({'</': '<\\/'})|raw }}
</style>
