{% extends "layout.twig" %}

{% block body %}
    <h1>环境检测</h1>
    <p class="lede">先确认服务器满足条件。必需项不通过，安装不会继续。</p>

    <section class="grp">
        <div class="tbl">
            {% for row in rows %}
                <div class="tr">
                    <div class="k">{{ row.label }}</div>
                    <div class="r">{{ row.required }}</div>
                    <div class="c">{{ row.current }}</div>
                    <div class="s {{ row.class }}">{{ row.word }}</div>
                </div>
            {% endfor %}
        </div>
        <p class="note">推荐项缺失不影响安装，只影响对应功能。目录不可写时，请把权限改成可写（755），并让运行网站的用户拥有这些目录。</p>
    </section>

    <section class="grp">
        <h2>伪静态配置示例</h2>
        <p class="gdesc">让所有页面请求都交给程序统一处理，按下面的规则配置即可。</p>
        <div class="codes">
            <div class="code-card">
                <div class="lab">NGINX</div>
                <div class="code">location / {
    try_files $uri $uri/ /index.php?$args;
}
# 后台走程序路由：admin/ 里只有静态资源、没有 index 文件，
# 不单独接管的话 nginx 会把它当目录索引，进后台就是 403
location = /admin {
    try_files $uri /index.php?$args;
}
location = /admin/ {
    return 301 /admin;
}
location ~ \.php$ {
    include fastcgi_params;
    fastcgi_pass 127.0.0.1:9000;
    fastcgi_param SCRIPT_FILENAME
        $document_root$fastcgi_script_name;
}</div>
            </div>
            <div class="code-card">
                <div class="lab">APACHE（.HTACCESS）</div>
                <div class="code">&lt;IfModule mod_rewrite.c&gt;
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
&lt;/IfModule&gt;</div>
            </div>
        </div>
    </section>

    {% if blocked %}
        <div class="acts">
            <div class="right">
                <a class="btn btn-ghost" href="?step=1">重新检测</a>
            </div>
        </div>
    {% else %}
        <form method="post" action="?step=1">
            <input type="hidden" name="{{ field }}" value="{{ token }}">
            <div class="acts">
                <div class="right">
                    <a class="btn btn-ghost" href="?step=1">重新检测</a>
                    <button class="btn btn-primary" type="submit" name="action" value="start">下一步</button>
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}
