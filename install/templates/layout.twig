{#
  墨林 - Molinink · 作者 Kira · https://www.molinink.com

  安装向导外壳(既有规范):字标行 + 步骤条 + 页脚六步(实现五步)共用,只有 .wiz-body 换。
  样式整份烤在 <style> 里 —— 向导跑在 config.php 之前,没有静态资源管线可用。
  步骤条五格是作者 2026-10-01 定的口径(设计稿六格,)。
#}
<!doctype html>
<html lang="zh-Hans">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>安装向导 · {{ titles[step] }} · 墨林</title>
    {# 站点图标(既有规范设计稿);向导跑在 config.php 之前,静态文件由 Nginx 直出 #}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icon/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icon/apple-touch-icon.png">
    <style>

  :root{
    --paper:#FAFAF8; --ink:#1B1C1E; --muted:#85837E; --rule:#E5E3DE; --accent:#B96A2E;
    --ink-soft:#2A2B2E; --ink-mute:#9A9892; --rule-2:#C9C6BF; --block:#F1EFEA; --field:#fff;
    --font-serif:"Noto Serif SC","Source Han Serif SC","Songti SC",SimSun,Georgia,serif;
    --font-sans:"Inter","Helvetica Neue",Arial,"Microsoft YaHei",sans-serif;
    --font-mono:"JetBrains Mono","Cascadia Mono",Consolas,"Courier New",monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:var(--font-sans);color:var(--ink);background:var(--paper);
    -webkit-font-smoothing:antialiased;}

  .stage{min-height:100vh;display:flex;flex-direction:column;}
  .col{width:100%;max-width:904px;margin:0 auto;padding:0 22px;}
  .wiz-head{padding-top:36px;}
  .top{display:flex;align-items:baseline;justify-content:space-between;gap:16px;}
  .mark{font-family:var(--font-serif);font-size:22px;line-height:1;letter-spacing:.02em;
    color:var(--ink);}
  .mark small{margin-left:10px;font-family:var(--font-sans);font-size:9.5px;letter-spacing:.3em;
    color:var(--ink-mute);}
  .tag{font-size:11px;letter-spacing:.24em;color:var(--muted);}
  .steps{display:grid;grid-template-columns:repeat(5,1fr);margin-top:28px;}
  .step{position:relative;display:flex;align-items:baseline;gap:8px;padding:0 12px 14px 0;
    border-bottom:1px solid var(--rule);font-size:12.5px;color:var(--muted);}
  .step .i{flex:0 0 auto;font-size:12px;letter-spacing:.02em;color:var(--muted);}
  .step .t{letter-spacing:.03em;}
  .step.done .i,.step.done .t{color:var(--ink);}
  .step.current .i,.step.current .t{color:var(--ink);}
  .step.current::after{content:"";position:absolute;left:0;right:12px;bottom:-1px;height:2px;
    background:var(--accent);}
  .wiz-body{flex:1 1 auto;padding:34px 0 30px;}
  h1{font-family:var(--font-serif);font-size:28px;font-weight:400;letter-spacing:.01em;
    line-height:1.3;color:var(--ink);}
  .lede{margin-top:10px;font-size:13px;line-height:1.8;letter-spacing:.02em;color:var(--muted);}

  .grp{margin-top:32px;}
  .grp > h2{font-family:var(--font-serif);font-size:17px;font-weight:400;letter-spacing:.02em;
    color:var(--ink);}
  .grp > .gdesc{margin-top:7px;font-size:12.5px;line-height:1.7;color:var(--muted);}

  .tbl{margin-top:16px;border-top:1px solid var(--rule);}
  .tr{display:grid;grid-template-columns:124px 1fr 1fr 96px;gap:18px;align-items:baseline;
    padding:13px 0;border-bottom:1px solid var(--rule);}
  .tr .k{font-size:12.5px;letter-spacing:.02em;color:var(--ink);}
  .tr .r{font-family:var(--font-mono);font-size:11.5px;line-height:1.6;color:var(--muted);}
  .tr .c{font-size:12.5px;line-height:1.6;color:var(--ink);}
  .tr .s{text-align:right;font-size:12.5px;letter-spacing:.02em;}
  .s.ok{color:var(--ink);}
  .s.ok::before{content:"✓ ";}
  .s.warn{color:var(--accent);}
  .s.warn::before{content:"! ";}
  .s.fail{color:var(--accent);}
  .s.fail::before{content:"✗ ";}
  .s.run{color:var(--muted);}
  .s.todo{color:#B3B0A9;}

  .note{margin-top:14px;font-size:12px;line-height:1.75;color:var(--muted);}
  .mono{font-family:var(--font-mono);font-size:11.5px;color:var(--ink);}
  .codes{margin-top:16px;display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .code-card{border:1px solid var(--rule);border-radius:6px;overflow:hidden;}
  .code-card .lab{padding:9px 14px;background:var(--field);border-bottom:1px solid var(--rule);
    font-size:11.5px;letter-spacing:.1em;color:var(--muted);}
  .code{padding:13px 14px;background:var(--block);font-family:var(--font-mono);font-size:11px;
    line-height:1.85;color:var(--ink);white-space:pre;overflow-x:auto;}
  .strip{margin-top:18px;padding:12px 14px;background:var(--block);border:1px solid var(--rule);
    border-radius:6px;font-size:12.5px;line-height:1.75;letter-spacing:.02em;color:var(--accent);}
  .strip b{font-weight:500;}
  .strip .sub{display:block;margin-top:5px;color:var(--muted);}
  .acts{margin-top:34px;padding-top:22px;border-top:1px solid var(--rule);display:flex;
    align-items:center;justify-content:space-between;gap:12px;}
  .acts .right{display:flex;align-items:center;gap:12px;margin-left:auto;}
  .acts-plain{border-top:0;}
  .btn{font-family:var(--font-sans);font-size:13px;letter-spacing:.1em;padding:10px 22px;
    border:1px solid transparent;border-radius:6px;cursor:pointer;text-decoration:none;
    transition:background .18s ease,color .18s ease,border-color .18s ease;}
  .btn-primary{background:var(--ink);color:var(--paper);}
  .btn-primary:hover{background:var(--ink-soft);}
  .btn-ghost{background:transparent;color:var(--muted);border-color:var(--rule);}
  .btn-ghost:hover{color:var(--ink);border-color:var(--rule-2);}
  .btn[disabled]{background:var(--block);color:var(--ink-mute);border-color:var(--rule);
    cursor:not-allowed;}
  .danger{background:transparent;border-color:var(--rule);color:var(--accent);}
  .danger:hover{border-color:var(--accent);color:var(--accent);}

  /* 复选框(口径同后台媒体库 .cb)与失败态两枚 */
  .cb{width:15px;height:15px;border:1.3px solid #C9C6BF;border-radius:4px;background:#fff;
    -webkit-appearance:none;appearance:none;cursor:pointer;position:relative;flex:0 0 auto;}
  .cb:checked{background:var(--ink);border-color:var(--ink);}
  .cb:checked::after{content:"";position:absolute;left:4.5px;top:1.5px;width:4px;height:8px;
    border-right:1.6px solid #fff;border-bottom:1.6px solid #fff;transform:rotate(42deg);}
  .cb:focus{outline:0;box-shadow:0 0 0 3px rgba(185,106,46,.13);}
  .pick{display:inline-flex;align-items:center;gap:9px;cursor:pointer;}
  .feed.fail .fh{color:var(--accent);}
  .feed.fail .fh::before{content:"✗";color:var(--accent);}
  .why{display:block;margin-top:6px;color:var(--accent);}

  .pagefoot{flex:0 0 auto;display:flex;align-items:baseline;justify-content:space-between;
    gap:14px;padding:20px 0 28px;font-size:11px;letter-spacing:.1em;color:var(--ink-mute);}
  .pagefoot span{white-space:nowrap;}
  .footrow{display:flex;align-items:baseline;justify-content:space-between;gap:14px;}
  .flds{margin-top:16px;border-top:1px solid var(--rule);}
  .field{display:grid;grid-template-columns:196px 1fr;gap:26px;align-items:start;
    padding:19px 0;border-bottom:1px solid var(--rule);}
  .field > label{padding-top:9px;font-size:13px;letter-spacing:.03em;color:var(--ink);}
  .field > label .req{color:var(--accent);margin-left:3px;}
  .ctrl{min-width:0;}
  .hint{margin-top:8px;font-size:12px;line-height:1.65;color:var(--muted);}
  input[type=text],input[type=password],select{
    width:100%;font-family:var(--font-sans);font-size:13.5px;color:var(--ink);
    background:var(--field);border:1px solid var(--rule);border-radius:6px;padding:9px 12px;
    letter-spacing:.02em;transition:border-color .18s ease,box-shadow .18s ease;
    -webkit-appearance:none;appearance:none;}
  input:focus,select:focus{outline:0;border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(185,106,46,.13);}
  select{background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),
    linear-gradient(135deg,var(--muted) 50%,transparent 50%);
    background-position:calc(100% - 16px) 55%,calc(100% - 11px) 55%;
    background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:34px;}
  input[disabled]{background:var(--block);color:var(--ink-mute);}
  .feed{margin-top:24px;border:1px solid var(--rule);border-radius:6px;background:var(--field);
    padding:15px 16px 16px;}
  .feed .fh{display:flex;align-items:baseline;gap:9px;font-size:13px;letter-spacing:.02em;
    color:var(--ink);}
  .feed .fh::before{content:"✓";color:var(--ink);font-size:12px;}
  .feed .fh .when{margin-left:auto;font-size:11.5px;letter-spacing:.03em;color:var(--muted);}
  .feed dl{margin-top:13px;display:grid;grid-template-columns:112px 1fr;gap:8px 12px;
    font-size:12.5px;letter-spacing:.02em;}
  .feed dt{color:var(--muted);}
  .feed dd{color:var(--ink);font-variant-numeric:tabular-nums;word-break:break-all;}
  {# 六份源件各带一份 .btn(第 2–6 步多写 color:var(--ink)),归并后它排在 .btn-primary 之后会把主按钮文字染成墨色;每步源件里只有一份,删去这份重复即还原原效 #}
  input[type=text],input[type=email],input[type=url],input[type=password]{
    width:100%;font-family:var(--font-sans);font-size:13.5px;color:var(--ink);
    background:var(--field);border:1px solid var(--rule);border-radius:6px;padding:9px 12px;
    letter-spacing:.02em;transition:border-color .18s ease,box-shadow .18s ease;}
  input:focus{outline:0;border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(185,106,46,.13);}
  .switch{display:inline-flex;align-items:center;gap:12px;cursor:pointer;padding-top:7px;
    font-size:13px;color:var(--muted);}
  .switch input{position:absolute;opacity:0;pointer-events:none;}
  .track{width:40px;height:22px;border-radius:99px;background:#D8D6D0;position:relative;
    transition:background .2s ease;flex:0 0 auto;}
  .knob{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;
    background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.18);transition:transform .2s ease;}
  .switch input:checked + .track{background:var(--accent);}
  .switch input:checked + .track .knob{transform:translateX(18px);}
  .switch .txt{color:var(--ink);}
  .strength{margin-top:11px;display:flex;align-items:center;gap:9px;}
  .strength .seg{width:34px;height:4px;border-radius:99px;background:var(--rule);}
  .strength .seg.on{background:var(--ink);}
  .strength .lab{font-size:11.5px;letter-spacing:.03em;color:var(--muted);}
  .inline-ok{margin-top:9px;font-size:12px;letter-spacing:.02em;color:var(--ink);}
  .inline-ok::before{content:"✓ ";}
  .chk{margin-top:16px;border-top:1px solid var(--rule);}
  .ck{display:grid;grid-template-columns:196px 1fr 104px;gap:18px;align-items:baseline;
    padding:13px 0;border-bottom:1px solid var(--rule);}
  .ck .k{font-size:12.5px;letter-spacing:.02em;color:var(--ink);}
  .ck .d{font-size:12.5px;line-height:1.6;color:var(--muted);}
  .ck .s{text-align:right;font-size:12.5px;letter-spacing:.02em;}
  .s.run::before{content:"";display:inline-block;width:8px;height:8px;margin-right:7px;
    border:1.3px solid var(--rule-2);border-top-color:var(--ink);border-radius:50%;
    vertical-align:-1px;}
 .step-5 .feed{margin-top:30px;border:1px solid var(--rule);border-radius:6px;background:var(--field);
    padding:18px 20px 20px;}
 .step-5 .feed .fh{display:flex;align-items:baseline;gap:10px;font-family:var(--font-serif);
    font-size:17px;letter-spacing:.02em;color:var(--ink);}
 .step-5 .feed .fh::before{content:"✓";font-family:var(--font-sans);font-size:14px;color:var(--ink);}
 .step-5 .feed dl{margin-top:15px;display:grid;grid-template-columns:112px 1fr;gap:9px 12px;
    font-size:12.5px;letter-spacing:.02em;}
 .step-5 .feed dd{color:var(--ink);word-break:break-all;}
 .step-5 .feed dd u{font-family:var(--font-mono);font-size:11.5px;text-decoration:none;color:var(--ink);}

 .step-5 .grp{margin-top:30px;}
 .step-5 .tbl{margin-top:14px;border-top:1px solid var(--rule);}
 .step-5 .tr{display:grid;grid-template-columns:124px 1fr;gap:18px;align-items:baseline;
    padding:13px 0;border-bottom:1px solid var(--rule);}
 .step-5 .tr .c{font-size:12.5px;line-height:1.6;color:var(--muted);}
 .step-5 .strip{margin-top:26px;padding:14px 16px;background:var(--block);border:1px solid var(--rule);
    border-radius:6px;font-size:13px;line-height:1.75;letter-spacing:.02em;color:var(--accent);}
 .step-5 .strip b{font-weight:500;}
 .step-5 .strip .sub{display:block;margin-top:6px;font-size:12.5px;color:var(--muted);}
 .step-5 .ck .d{font-size:12.5px;line-height:1.7;color:var(--muted);}
 .step-5 .admwarn{margin-top:14px;display:flex;align-items:baseline;gap:16px;
    padding:12px 16px;background:var(--block);border:1px solid var(--rule);border-radius:6px;
    font-size:12.5px;line-height:1.7;letter-spacing:.02em;color:var(--accent);}
 .step-5 .admwarn::before{content:"!";font-size:12px;flex:0 0 auto;}
 .step-5 .admwarn b{font-weight:500;}

    @media (max-width: 768px) {
/* ── 移动端版式(设计稿视口 390)──
     本页即移动版,不做媒体查询。以下只覆盖桌面版的排布数值,
     色值、字号层级、组件样式一律沿用同页桌面源件,未新增任何值。
     横向可滑的步骤条 = 既有规范「分组页签横向可滚(隐藏滚动条)」同一口径;
     表单单列、字段上下内边距 16px = 既有规范同一口径。 */
  .col{padding:0 18px;}
  .wiz-head{padding-top:26px;}
  .mark{font-size:20px;}
  .steps{display:flex;gap:18px;margin-top:22px;overflow-x:auto;
    scrollbar-width:none;-ms-overflow-style:none;}
  .steps::-webkit-scrollbar{display:none;}
  .step{flex:0 0 auto;padding:0 0 12px;}
  .step.current::after{right:0;}
  .wiz-body{padding:26px 0 24px;}
  h1{font-size:24px;}
  .lede{font-size:12.5px;line-height:1.75;}
  .grp{margin-top:26px;}
  .flds,.tbl,.chk{margin-top:12px;}
  .field{grid-template-columns:1fr;gap:8px;padding:16px 0;}
  .field > label{padding-top:0;}
  /* 四列/三列表格在 390 下按 DOM 顺序竖排:项 → 要求 → 实测 → 状态 */
  .tr{display:block;padding:12px 0;}
  .tr .r,.tr .c{margin-top:5px;}
  .tr .s{margin-top:6px;text-align:left;}
  .ck{display:block;padding:13px 0;}
  .ck .d{margin-top:5px;}
  .ck .s{margin-top:6px;text-align:left;}
  .codes{grid-template-columns:1fr;}
  .feed dl{grid-template-columns:96px 1fr;}
  .strength{flex-wrap:wrap;}
  .acts{margin-top:26px;padding-top:18px;}
    }
    /* 2026-10-25 完成页：可复制的服务器片段（两段都不用改路径） */
    .snip-act{display:flex;align-items:center;justify-content:space-between;gap:14px;
        padding:10px 14px;border-top:1px solid var(--rule);background:var(--field);}
    .snip-act .tip{font-size:11.5px;line-height:1.6;color:var(--muted);}
    .snip-act .btn{padding:6px 14px;font-size:12px;letter-spacing:.06em;white-space:nowrap;}
    .snip-note{margin-top:14px;font-size:12.5px;line-height:1.75;color:var(--muted);}
    .snip-note b{color:var(--ink);font-weight:500;}
    </style>
</head>
<body>
<div class="stage step-{{ step }}">
    <header class="wiz-head">
        <div class="col">
            <div class="top">
                <div class="mark">墨林<small>MOLININK</small></div>
                <div class="tag">安装向导</div>
            </div>
            <nav class="steps" aria-label="安装步骤">
                {% for number, title in titles %}
                    <span class="step{% if all_done or number < step %} done{% elseif number == step %} current{% endif %}">
                        <span class="i">{{ ['0', '①', '②', '③', '④', '⑤', '⑥'][number] }}</span>
                        <span class="t">{{ title }}</span>
                    </span>
                {% endfor %}
            </nav>
        </div>
    </header>

    <main class="wiz-body">
        <div class="col">
            {% if notice %}
                <div class="strip" role="alert">{{ notice }}</div>
            {% endif %}

            {% block body %}{% endblock %}
        </div>
    </main>

    <footer class="pagefoot">
        <div class="col footrow">
            <span>© {{ "now"|date("Y") }} 墨林</span>
            <span>Powered by MolinInk</span>
        </div>
    </footer>
</div>
{% block script %}{% endblock %}
</body>
</html>