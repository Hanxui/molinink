{# 墨林 - Molinink · 作者 Kira · https://www.molinink.com #}
{#
  找回密码(《123-找回密码实现规格》§6.1 / §6.2)。
  默认态与已发送态是同一张卡:提交后无论账号在不在都给同一句反馈(不透露注册情况)。
  内核不发信 —— 令牌与链接由本屏生成,寄出去那一步留给发信插件(作者 2026-10-01 定)。
  没插件接棒时(no_mailer)不再说"邮件已发出":那是句会被站长当真的假话(2026-10-17 作者定,约定"页面上的字必须说真话")。
#}
{% extends "auth_layout.twig" %}

{% set page_title = __('找回密码') %}
{% set card_title = __('找回密码') %}

{% block title %}{{ __('找回密码') }} · {{ __('墨林') }}{% endblock %}
{% block shell_class %} auth-recover{% endblock %}

{% block card %}
    {% if no_mailer %}
        <p class="lede">{{ __('这台站还没有启用邮件发送，重置邮件发不出去。请联系管理员帮你改密码。') }}</p>
    {% else %}
        <p class="lede">{{ __('填写注册时用的邮箱，我们会寄一封重置邮件过去。') }}</p>
    {% endif %}

    {% if notice is not empty %}
        <p class="strip">{{ notice }}</p>
    {% endif %}

    {% if no_mailer %}
        {# 发不出去就别摆一张会让人干等的表单:说明 + 回登录页 #}
        <p class="hint">{{ __('管理员可在此站后台的「用户」里重置，或用命令行 molin user:password 改。') }}</p>
        <a class="btn btn-primary" href="{{ path('login') }}">{{ __('返回登录') }}</a>
    {% else %}
        <form method="post" action="{{ path('lostpassword') }}">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">

            <div class="fld">
                <label for="e">{{ __('邮箱') }}<span class="req">*</span></label>
                <input id="e" type="email" name="email" value="{{ email }}" autocomplete="email" required
                    {% if email is empty %}placeholder="you@example.com"{% endif %}>
            </div>

            {% if sent %}
                <p class="done">{{ __('邮件已发出，%d 小时内有效。', 'molin', ttl_hours) }}</p>
                <p class="hint">{{ __('未收到？请检查垃圾邮件文件夹。') }}</p>
            {% else %}
                <p class="hint">{{ __('账号不存在时也会给出同样的提示，不透露注册情况。') }}</p>
            {% endif %}

            <button class="btn {{ sent ? 'btn-ghost' : 'btn-primary' }}" type="submit">{{ sent ? __('重新发送') : __('发送重置邮件') }}</button>
        </form>
    {% endif %}
{% endblock %}
