{# 墨林 - Molinink · 作者 Kira · https://www.molinink.com #}
{#
  重置密码(《123-找回密码实现规格》§6.3 / §6.4)。
  渲染哪一态完全由令牌校验结果决定:通过 → 设新密码;不通过 → 失效态(表单整块不渲染)。
  失效态那句"每条链接只能使用一次"是实装口径:complete() 用完即删。
#}
{% extends "auth_layout.twig" %}

{% set page_title = __('重置密码') %}
{% set card_title = __('重置密码') %}

{% block title %}{{ __('重置密码') }} · {{ __('墨林') }}{% if not valid %}（{{ __('链接已失效') }}）{% endif %}{% endblock %}
{% block shell_class %} auth-recover{% endblock %}

{% block card %}
    {% if valid %}
        <p class="lede">{{ __('为账号 %s 设置一个新密码。', 'molin', account) }}</p>

        {% if notice is not empty %}
            <p class="strip">{{ notice }}</p>
        {% endif %}

        <form method="post" action="{{ path('resetpassword') }}">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <input type="hidden" name="token" value="{{ token }}">

            <div class="fld">
                <label for="p">{{ __('新密码') }}<span class="req">*</span></label>
                <input id="p" type="password" name="password" autocomplete="new-password" required>
                <div class="meter-row">
                    <span class="meter"><i style="width:0"></i></span>
                    <span class="meter-txt">{{ __('强度：—') }}</span>
                </div>
                <p class="hint">{{ __('至少 8 位，建议含大小写字母、数字与符号。') }}</p>
            </div>
            <div class="fld">
                <label for="p2">{{ __('确认新密码') }}<span class="req">*</span></label>
                <input id="p2" type="password" name="password2" autocomplete="new-password" required>
            </div>

            <p class="hint">{{ __('重置后其他设备需重新登录。') }}</p>

            <button class="btn btn-primary" type="submit">{{ __('重置密码') }}</button>
        </form>
    {% else %}
        <p class="strip dead">{{ __('重置链接已失效或无效，请重新申请一次。') }}</p>
        <p class="hint dead">{{ __('每条链接只能使用一次，发出后 %d 小时内有效。', 'molin', ttl_hours) }}</p>

        <a class="btn btn-ghost" href="{{ path('lostpassword') }}">{{ __('重新发送重置邮件') }}</a>
    {% endif %}
{% endblock %}
