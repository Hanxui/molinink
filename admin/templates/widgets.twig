{#
  墨林 - Molinink · 作者 Kira · https://www.molinink.com

  挂件(《108》,基准 后台挂件-定稿 / 后台挂件-移动端-定稿两份)。
  一次保存的整页表单:哪个区、放哪些挂件、什么顺序。整页无输入框/下拉/复选框,
  操作全靠按钮(右栏「移除」、左栏「加到侧栏 / 加到页脚」、保存栏「保存布局」);
  `widgets[区][序][字段]` 是一组不可见隐藏域,只当排布的数据通道,不产生焦点环。
  桌面与移动各挂一份结构(右栏 `.from` 桌面是独立列、移动换行进名称块),由 .d / .m 切换。
#}
{% extends "layout.twig" %}

{% block body %}
    <div class="eyebrow">{{ __('外观') }}</div>
    <h1>{{ __('挂件') }}</h1>
    <p class="lede">{{ __('挂件由主题和插件提供，这里只决定放在哪个区、按什么顺序排。') }}</p>

    {% include 'partials/appearance-nav.twig' %}

    {# 2026-10-17:主题不调 widget_area() 时,这一屏配了也看不见 —— 说清楚,别让人对着空开关忙活 #}
    {% if theme_used_areas is empty %}
        <p class="gdesc">{{ __('当前主题（%s）一个挂件位都没画：这里排的挂件，站点上看不到。要让它们出现，主题模板里得调用 widget_area()，区名对得上 sidebar / footer。', 'molin', theme_name) }}</p>
    {% elseif theme_used_areas|length < areas|length %}
        <p class="gdesc">{{ __('当前主题只画了这些挂件区：%s。其余区排了也不会显示。', 'molin', theme_used_areas|join('、')) }}</p>
    {% endif %}

    <form id="widgets-form" method="post" action="{{ save_url }}">
        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">

        {# 排布数据通道:整份布局只在表单里出现一次(不随桌面/移动双份)。 #}
        {% for area in areas %}
            {% for row in area.rows %}
                <input type="hidden" name="widgets[{{ area.id }}][{{ loop.index0 }}][type]" value="{{ row.type }}">
                <input type="hidden" name="widgets[{{ area.id }}][{{ loop.index0 }}][title]" value="{{ row.title }}">
                <input type="hidden" name="widgets[{{ area.id }}][{{ loop.index0 }}][sub]" value="{{ row.sub }}">
                <input type="hidden" name="widgets[{{ area.id }}][{{ loop.index0 }}][from]" value="{{ row.from }}">
            {% endfor %}
        {% endfor %}

        {# ── 桌面:左可用挂件 + 右挂件区 ── #}
        <div class="split d">
            <section>
                <h2>{{ __('可用挂件') }}</h2>
                <p class="pdesc">{{ __('这些是当前主题与已启用插件注册进来的。') }}</p>
                <div class="avail">
                    {% for w in available %}
                        <div class="av">
                            <div class="nm"><div class="t">{{ w.name }}</div><div class="s">{{ w.desc }}</div></div>
                            <div class="to">
                                {% for b in w.buttons %}
                                    <button class="btn btn-ghost xs" type="submit" name="do" value="{{ b.value }}">{{ b.label }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="tip">{{ __('装了新插件、启用新主题之后，这里的清单会跟着变。挂件本身不写业务，只把已有内容摆出来。') }}</p>
            </section>

            <section>
                {% for area in areas %}
                    {# data-area 与行上的 data-* 只给脚本看:拖动后由它重排那组隐藏输入(admin.js 挂件段) #}
                    <div class="zone" data-area="{{ area.id }}">
                        <div class="zhd">
                            <div class="slot"><span class="cn">{{ area.cn }}</span></div>
                            <span class="cnt">{{ __('已放') }} <b>{{ area.count }}</b> {{ __('个') }}</span>
                        </div>
                        {% for row in area.rows %}
                            <div class="wrow" data-type="{{ row.type }}" data-title="{{ row.title }}" data-sub="{{ row.sub }}" data-from="{{ row.from }}">
                                <span class="handle" tabindex="0" role="button" aria-label="{{ __('拖动排序，或用上下方向键移动') }}"><i></i><i></i><i></i></span>
                                <div><div class="t">{{ row.title }}</div>{% if row.sub is not empty %}<div class="sub">{{ row.sub }}</div>{% endif %}</div>
                                <span class="from">{{ row.from }}</span>
                                <button class="rm" type="submit" name="do" value="remove:{{ area.id }}:{{ loop.index0 }}">{{ __('移除') }}</button>
                            </div>
                        {% endfor %}
                        <div class="drop">{{ area.drop }}</div>
                        <p class="tip">{{ area.tip }}</p>
                    </div>
                {% endfor %}
            </section>
        </div>

        {# ── 移动:单列堆叠,右栏 .from 换行进名称块,.drop 文案改「从上面」 ── #}
        <div class="split m">
            <section>
                <h2>{{ __('可用挂件') }}</h2>
                <p class="pdesc">{{ __('这些是当前主题与已启用插件注册进来的。') }}</p>
                <div class="avail">
                    {% for w in available %}
                        <div class="av">
                            <div class="t">{{ w.name }}</div><div class="s">{{ w.desc }}</div>
                            <div class="to">
                                {% for b in w.buttons %}
                                    <button class="btn btn-ghost xs" type="submit" name="do" value="{{ b.value }}">{{ b.label }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <p class="tip">{{ __('装了新插件、启用新主题之后，这里的清单会跟着变。挂件本身不写业务，只把已有内容摆出来。') }}</p>
            </section>

            <section>
                {% for area in areas %}
                    <div class="zone" data-area="{{ area.id }}">
                        <div class="zhd">
                            <div class="slot"><span class="cn">{{ area.cn }}</span></div>
                            <span class="cnt">{{ __('已放') }} <b>{{ area.count }}</b> {{ __('个') }}</span>
                        </div>
                        {% for row in area.rows %}
                            <div class="wrow" data-type="{{ row.type }}" data-title="{{ row.title }}" data-sub="{{ row.sub }}" data-from="{{ row.from }}">
                                <span class="handle" tabindex="0" role="button" aria-label="{{ __('拖动排序，或用上下方向键移动') }}"><i></i><i></i><i></i></span>
                                <div>
                                    <div class="t">{{ row.title }}</div>
                                    {% if row.sub is not empty %}<div class="sub">{{ row.sub }}</div>{% endif %}
                                    <div class="from">{{ row.from }}</div>
                                </div>
                                <button class="rm" type="submit" name="do" value="remove:{{ area.id }}:{{ loop.index0 }}">{{ __('移除') }}</button>
                            </div>
                        {% endfor %}
                        <div class="drop">{{ area.drop_m }}</div>
                        <p class="tip">{{ area.tip_m }}</p>
                    </div>
                {% endfor %}
            </section>
        </div>
    </form>
{% endblock %}

{% block savebar %}
    <footer class="savebar savebar-widgets">
        <div class="status">{% if has_saved %}{{ __('上次保存：') }}<b><span class="d">{{ updated_date }} </span>{{ updated_time }}</b>{% else %}{{ __('还没保存过') }}{% endif %}</div>
        <div class="btns">
            <a class="btn btn-ghost" href="{{ cancel_url }}">{{ __('取消') }}</a>
            <button class="btn btn-primary" type="submit" name="do" value="save" form="widgets-form">{{ __('保存布局') }}</button>
        </div>
    </footer>
{% endblock %}
