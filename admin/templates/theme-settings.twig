{#
  墨林 - Molinink · 作者 Kira · https://www.molinink.com

  主题设置(《91》,基准 后台主题设置-定稿-2026-09-30):字段 + 底部保存栏。
  字段全集来自主题 theme.json 的 settings 声明(《36》),本模板不写死任何字段。
  2026-10-25:右栏「实时预览」iframe 整块撤掉(维护两只主题的 preview_vars、还要 JS 注入
  变量才看得出来,实际没人靠它调色;想看效果直接点外观页的「预览」开前台)。
#}
{% extends "layout.twig" %}

{% block body %}
    {# 校验没过时:哪一组有错就由服务端直接展开(不靠脚本),这里再算一遍错了几处、第一条在哪。
       汇总条是无脚本也成立的静态文字,「跳到第一个错误」本身就是锚点,JS 只是让它滚到中间并聚焦 #}
    {% set err_count = 0 %}
    {% set first_err = '' %}
    {% for group in groups %}
        {% for field in group.fields %}
            {% if field.error %}
                {% set err_count = err_count + 1 %}
                {% if first_err == '' %}{% set first_err = field.path|replace({'.': '-'}) %}{% endif %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    <div class="head">
        <div class="tx">
            <div class="eyebrow">{{ __('外观') }}</div>
            <h1>{{ __('主题设置') }}</h1>
            <p class="lede">{{ __('字段由主题的 theme.json 声明，后台自动渲染，点保存才落库。想看效果：保存后开前台，或在「外观」里点该主题的「预览」。') }}</p>
            <div class="ctx">{{ __('正在配置：') }}<b>{{ theme_title }}</b>　{{ __('版本') }} {{ theme_version }}</div>
        </div>
        <div class="btns">
            <form method="post" action="{{ import_action }}" enctype="multipart/form-data">
                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                <input type="hidden" name="theme" value="{{ theme_slug }}">
                <input type="file" name="file" id="import-file" accept=".json,application/json" data-auto hidden>
                <label class="btn btn-ghost" for="import-file">{{ __('导入设置') }}</label>
            </form>
            <a class="btn btn-ghost" href="{{ export_url }}" data-noleave>{{ __('导出设置') }}</a>
        </div>
    </div>

    {% if err_count > 0 %}
        <div class="strip danger errsum" role="alert">
            <span class="sum">{{ __('有 %s 处填写未通过，已展开对应分组', 'molin', err_count) }}</span>
            <a class="jump" href="#f-{{ first_err }}" data-jump-err>{{ __('跳到第一个错误') }}</a>
        </div>
    {% endif %}

    {% include 'partials/appearance-nav.twig' %}

    <form id="settings-form" method="post" action="{{ settings_action }}">
        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
        <input type="hidden" name="theme" value="{{ theme_slug }}">

        <div class="split">
            <div class="cfg">
                {% for group in groups %}
                    {# 有错的组不折叠:保存失败后面对十行收起的组,用户不知道错在哪一项 #}
                    {% set has_err = false %}
                    {% for f in group.fields %}{% if f.error %}{% set has_err = true %}{% endif %}{% endfor %}
                    <section class="grp{{ has_err ? '' : ' closed' }}">
                        <button class="gh" type="button" data-grp aria-expanded="{{ has_err ? 'true' : 'false' }}"><span class="chev"></span><span class="gt">{{ group.label }}</span><span class="gc">{{ __('%s 项', 'molin', group.count) }}</span></button>
                        <div class="gbody">
                            {# 「恢复默认」只能落在 .gbody 第一行:组头是 button,里面不许再嵌可交互元素 #}
                            <div class="ghbar">
                                {% if group.desc %}<p class="gdesc">{{ group.desc }}</p>{% endif %}
                                <details class="rst grp-rst">
                                    <summary class="lnk">{{ __('恢复默认') }}</summary>
                                    <div class="rsc">
                                        <p>{{ __('只把这一组清回 theme.json 的默认值，别的组不动。') }}</p>
                                        <div class="acts">
                                            <button class="btn btn-ghost btn-sm" type="submit" form="grp-rst-{{ group.key }}">{{ __('确定恢复') }}</button>
                                            <button class="lnk" type="button" data-close>{{ __('取消') }}</button>
                                        </div>
                                    </div>
                                </details>
                            </div>
                            <div class="fields">
                                {% set section = '' %}
                                {% for field in group.fields %}
                                    {# 字段声明了 section:同组内换段时插一行子标题(《36》首页那三十项分段) #}
                                    {% if field.section is defined and field.section and field.section != section %}
                                        {% set section = field.section %}
                                        <h3 class="gsub">{{ field.section }}</h3>
                                    {% endif %}
                                    <div class="field{{ field.error ? ' err' : '' }}">
                                        {# 开关类**不给 for**:for 会把字段名也变成那个 checkbox 的点击热区,
                                           点一下(甚至只是想选字)就把值翻过去了 —— 2026-10-16 修 #}
                                        <label{% if field.type != 'bool' %} for="f-{{ field.path|replace({'.': '-'}) }}"{% endif %}>{{ field.label }}</label>
                                        <div class="ctrl">
                                            {% if field.type == 'color' %}
                                                {# 色块就地当取色器:原生 color 框盖在色块上(同一颗色片,不出两个并排方块);
                                                   取色器不带 name,免得表单多递一个值 #}
                                                <div class="color">
                                                    <span class="sw" style="background:{{ field.swatch }}"><input type="color" class="cp" value="{{ field.swatch ?: '#000000' }}" aria-label="{{ __('取色器：%s', 'molin', field.label) }}"></span>
                                                    <input type="text" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" value="{{ field.value }}" spellcheck="false">
                                                </div>
                                            {% elseif field.type == 'bool' %}
                                                <label class="switch">
                                                    <input type="hidden" name="{{ field.name }}" value="0">
                                                    <input type="checkbox" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" value="1" data-switch{{ field.value ? ' checked' : '' }}>
                                                    <span class="track"><span class="knob"></span></span>
                                                    <span class="txt">{{ field.value ? __('开启') : __('关闭') }}</span>
                                                </label>
                                            {% elseif field.type == 'select' %}
                                                <select id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}">
                                                    {% for option in field.options %}
                                                        <option value="{{ option.value }}"{{ option.selected ? ' selected' : '' }}>{{ option.label }}</option>
                                                    {% endfor %}
                                                </select>
                                            {% elseif field.type == 'range' %}
                                                <div class="rangew">
                                                    <input type="range" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" min="{{ field.min }}" max="{{ field.max }}" step="{{ field.step }}" value="{{ field.value }}" data-range>
                                                    <span class="rv">{{ field.value }}</span>
                                                </div>
                                            {% elseif field.type == 'number' %}
                                                <div class="numw">
                                                    <input type="number" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" min="{{ field.min }}" max="{{ field.max }}" value="{{ field.value }}">
                                                    {% if field.unit %}<span class="u">{{ field.unit }}</span>{% endif %}
                                                </div>
                                            {% elseif field.type == 'image' %}
                                                <div class="pick">
                                                    {# 预览图:选完/传完立刻写库,这里出的就是页面上会出的那张(2026-10-16 修) #}
                                                    <span class="pv">{% if field.attachment and field.attachment.preview %}<img src="{{ field.attachment.preview }}" alt="">{% endif %}</span>
                                                    <div class="pt">
                                                        {% if field.attachment %}
                                                            <div class="fn">{{ field.attachment.name }}</div>
                                                            <div class="fs">{{ __('附件') }} {{ field.attachment.id }} · {{ field.attachment.size_text }}</div>
                                                        {% else %}
                                                            <div class="fn">{{ __('还没选图片') }}</div>
                                                            <div class="fs">{{ __('从媒体库选一张，或直接传一张') }}</div>
                                                        {% endif %}
                                                        <div class="pa">
                                                            <a class="btn btn-ghost btn-sm" href="{{ settings_url }}&pick=1&field={{ field.path|url_encode }}">{{ __('从媒体库选择') }}</a>
                                                            {% if field.attachment %}<button class="lnk" type="button" data-unset="f-{{ field.path|replace({'.': '-'}) }}">{{ __('移除') }}</button>{% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                                <input type="hidden" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" value="{{ field.value }}">
                                            {% elseif field.type == 'repeater' %}
                                                <div class="rep" data-rep data-sub="{{ field.sub_fields|json_encode|e('html_attr') }}" data-prefix="{{ field.name|e('html_attr') }}">
                                                    {% for row in field.rows %}
                                                        <div class="ritem">
                                                            <span class="idx">{{ row.index }}</span>
                                                            {% for cell in row.cells %}
                                                                <input type="text" name="{{ cell.name }}" value="{{ cell.value }}">
                                                            {% endfor %}
                                                            <button class="lnk" type="button" data-rmrow>{{ __('删除') }}</button>
                                                        </div>
                                                    {% endfor %}
                                                    <button class="btn btn-ghost btn-sm radd" type="button" data-radd>{{ __('＋ 添加一项') }}</button>
                                                </div>
                                            {% elseif field.type == 'code' %}
                                                {# 属性一律走 "{% if %} 字面量 {% endif %}" 的形状写:
                                                   拼成字符串再输出会被 Twig 再转义一道,变成 maxlength=&quot;10&quot;,
                                                   浏览器当无效值丢掉 —— 2026-10-16 修 #}
                                                <textarea class="codebox" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" rows="{{ field.rows ?: 10 }}" spellcheck="false"{% if field.lang %} data-lang="{{ field.lang }}"{% endif %}>{{ field.value }}</textarea>
                                            {% elseif field.type == 'textarea' %}
                                                <textarea id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" rows="{{ field.rows ?: 5 }}"{% if field.maxlength %} maxlength="{{ field.maxlength }}"{% endif %}>{{ field.value }}</textarea>
                                            {% else %}
                                                <input type="text" id="f-{{ field.path|replace({'.': '-'}) }}" name="{{ field.name }}" value="{{ field.value }}"{% if field.maxlength %} maxlength="{{ field.maxlength }}"{% endif %}{% if field.placeholder %} placeholder="{{ field.placeholder }}"{% endif %}>
                                            {% endif %}
                                            {% if field.error %}<div class="errtx">{{ field.error|codes }}</div>{% endif %}
                                            {% if field.hint %}<div class="hint">{{ field.hint|codes }}</div>{% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                {% endfor %}
            </div>
        </div>
    </form>
{% endblock %}

{% block savebar %}
    <div class="savebar">
        <div class="status">{{ __('上次保存：') }}<b>{{ updated_text }}</b></div>
        <div class="btns">
            <details class="rst">
                <summary class="btn btn-ghost">{{ __('重置为默认') }}</summary>
                <div class="rsc">
                    <p>{{ __('清空这只主题的用户值，全部回到 theme.json 的默认。') }}</p>
                    <form method="post" action="{{ reset_action }}">
                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                        <input type="hidden" name="theme" value="{{ theme_slug }}">
                        <button class="btn btn-ghost btn-sm" type="submit">{{ __('确定重置') }}</button>
                        <button class="lnk" type="button" data-close>{{ __('取消') }}</button>
                    </form>
                </div>
            </details>
            <button class="btn btn-primary" type="submit" form="settings-form">{{ __('保存') }}</button>
        </div>
    </div>

    {# 每组「恢复默认」各走一只独立表单:主表单里不能嵌表单,按钮靠 form 属性牵过来;
       无脚本也能提交,POST 只多带一个 group 键(后端按组回滚,《36》§5) #}
    {% for group in groups %}
        <form id="grp-rst-{{ group.key }}" method="post" action="{{ reset_action }}" hidden>
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <input type="hidden" name="theme" value="{{ theme_slug }}">
            <input type="hidden" name="group" value="{{ group.key }}">
        </form>
    {% endfor %}
{% endblock %}

{% block dialog %}
    {% if picker %}
        <div class="dlg wide" role="dialog" aria-modal="true" aria-labelledby="pick-title">
            <div class="tag">{{ __('媒体库') }}</div>
            <h2 id="pick-title">{{ __('选择图片') }}</h2>
            <form class="filters" method="get" action="{{ picker.action }}">
                <input type="hidden" name="theme" value="{{ picker.theme }}">
                <input type="hidden" name="pick" value="1">
                <input type="hidden" name="field" value="{{ picker.field }}">
                <div class="search">
                    <span class="ico"></span>
                    <input type="text" name="q" placeholder="{{ __('搜索文件名') }}" value="{{ picker.q }}">
                </div>
                <div class="spacer"></div>
                <button class="btn btn-ghost more" type="submit">{{ __('筛选') }}</button>
            </form>
            <div class="grid">
                {% for item in picker.items %}
                    <form method="post" action="{{ picker.set_url }}">
                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                        <input type="hidden" name="theme" value="{{ picker.theme }}">
                        <input type="hidden" name="field" value="{{ picker.field }}">
                        <input type="hidden" name="media" value="{{ item.id }}">
                        <button class="cell{{ item.id == picker.selected ? ' sel' : '' }}" type="submit">
                            <span class="kind">{{ item.kind }}</span>
                            <span class="tick"></span>
                            <div class="thumb">
                                {% if item.thumb %}<img src="{{ item.thumb }}" alt="">{% else %}<svg viewBox="0 0 120 90" fill="none" stroke="#B3B0A9" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="88" cy="26" r="8"/><path d="M8 70 34 42 52 60 72 34 112 70"/><path d="M8 70h104"/><path d="M30 70v-9M78 70v-7"/></svg>{% endif %}
                            </div>
                            <div class="bd">
                                <div class="fn">{{ item.name }}</div>
                                <div class="mi">{{ item.dims }}{% if item.dims %} · {% endif %}{{ item.size_text }}</div>
                            </div>
                        </button>
                    </form>
                {% else %}
                    <p class="lede">{{ __('媒体库还是空的。先到「媒体」传一张图，再回来选。') }}</p>
                {% endfor %}
            </div>
            <div class="pick-pager">
                <div class="info">{{ picker.info }}</div>
                <div class="pages">
                    {% for link in picker.pages %}
                        <a href="{{ link.url }}"{{ link.active ? ' class="cur"' : '' }}>{{ link.page }}</a>
                    {% endfor %}
                </div>
            </div>
            {# 对话框里就能直接传一张:选文件即传(data-auto),真进度条走 .upbar,
               传完服务端直接把这个字段写库并回设置页 —— 页面上的预览图就是它的样子 #}
            <form class="dup" method="post" action="{{ picker.upload_url }}" enctype="multipart/form-data" data-progress>
                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                <input type="hidden" name="theme" value="{{ picker.theme }}">
                <input type="hidden" name="field" value="{{ picker.field }}">
                <input type="file" name="image" id="pick-file" accept="image/*" data-auto hidden>
                <label class="btn btn-primary btn-sm" for="pick-file"><span class="plus">＋</span>{{ __('传一张新的') }}</label>
                <div class="upbar" hidden><i></i><span class="pc">0%</span></div>
                <div class="uperr" hidden></div>
            </form>
            <div class="foot">
                <a class="btn btn-ghost" href="{{ picker.cancel_url }}" data-cancel>{{ __('取消') }}</a>
            </div>
        </div>
    {% endif %}
{% endblock %}
