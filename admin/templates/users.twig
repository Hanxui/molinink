{#
  墨林 - Molinink · 作者 Kira · https://www.molinink.com

  用户列表(设计稿)。
  页签 / 筛选 / 批量 / 行内操作要的数据还没进控制器,先落「页头 + 行列表」两层;
  角色用方块标记(.role 五档,与参考图同构),新建入口与既有规范同一道门槛(user.create)。
  行内「编辑」与新建同门槛(user.create),进既有规范编辑屏 users/{id}/edit;窄屏列宽由 .page-users 作用域重置。
  数字列(ID)带 .nowrap,悬停/窄屏都不折行。
#}
{% extends "layout.twig" %}

{% block body %}
    {% set role_marks = {'administrator': 'adm', 'editor': 'ed', 'author': 'au', 'contributor': 'co', 'subscriber': 'sb'} %}
    {% set role_labels = {'administrator': __('管理员'), 'editor': __('编辑'), 'author': __('作者'), 'contributor': __('贡献者'), 'subscriber': __('订阅者')} %}
    {% set status_labels = {'active': __('正常'), 'pending': __('待验证'), 'banned': __('已封禁')} %}

    <div class="head">
        <div class="tx">
            <div class="eyebrow">{{ __('权限') }}</div>
            <h1>{{ __('用户') }}</h1>
            <p class="lede">{{ __('能进来写字的人都在这里。角色决定他能动什么，菜单也按这个收起。') }}</p>
        </div>
        {% if current_user and current_user.holds('user.create') %}
            <a class="btn btn-primary" href="{{ path('admin', {path: 'users/new'}) }}"><span class="plus">＋</span>{{ __('新建用户') }}</a>
        {% endif %}
    </div>

    {% include 'partials/users-nav.twig' %}

    <div class="table users-list">
        <div class="thead">
            <span>{{ __('ID') }}</span>
            <span>{{ __('用户名') }}</span>
            <span>{{ __('邮箱') }}</span>
            <span>{{ __('角色') }}</span>
            <span>{{ __('状态') }}</span>
        </div>

        {% for user in users %}
            {% set role_mark = role_marks[user.role]|default('') %}
            <div class="tr">
                <span class="cell num nowrap">{{ user.id }}</span>
                <div class="who">
                    <div class="t">{{ user.display_name ?: user.username }}</div>
                    <div class="sub">{{ user.username }}</div>
                    {% if current_user and current_user.holds('user.create') %}
                        <div class="acts">
                            <a class="act" href="{{ path('admin', {path: 'users/' ~ user.id ~ '/edit'}) }}">{{ __('编辑') }}</a>
                        </div>
                    {% endif %}
                </div>
                <span class="cell">{{ user.email }}</span>
                <span><span class="role{% if role_mark %} {{ role_mark }}{% endif %}"><i></i>{{ role_labels[user.role]|default(user.role) }}</span></span>
                <span class="cell">{{ status_labels[user.status]|default(user.status) }}</span>
            </div>
        {% else %}
            <div class="empty"><div class="et">{{ __('还没有用户。') }}</div></div>
        {% endfor %}
    </div>
{% endblock %}
