{# 墨林 - Molinink · 作者 Kira · https://www.molinink.com #}
{#
  登录 / 注册 / 找回 / 邮箱验证四页共用的独立壳。
  与后台侧栏壳无关:无侧栏、无顶栏,只一张卡片 + 底部双版权条,整页 100vh 不滚动。
  数值逐字抄设计稿;改这里就是改设计稿,先动规格再动码。
#}
<!doctype html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ page_title }} · {{ __('墨林后台') }}{% endblock %}</title>
    {# 站点图标(既有规范设计稿):与前台同一套根相对地址 #}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icon/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icon/apple-touch-icon.png">
    {# 版本查询串:升版本即换 URL,浏览器旧缓存的 admin.css/admin.js 自动失效 #}
    <link rel="stylesheet" href="/admin/assets/admin.css?v={{ kernel_version }}">
</head>
<body class="auth-body{% block shell_class %}{% endblock %}">
<div class="stage">
    <div class="mid">
        <div class="auth">
            <div class="mark">{{ site_name }}<small>Molinink</small></div>

            <div class="card">
                <h1>{{ card_title }}</h1>
                {% block card %}{% endblock %}
            </div>

            <a class="back" href="{{ path('home') }}">← {{ __('返回站点') }}</a>
        </div>
    </div>

    <footer class="pagefoot">
        <span>© {{ "now"|date("Y") }} {{ site_name }}</span>
        <span>Powered by MolinInk</span>
    </footer>
</div>
<script>window.MOLIN_I18N = {{ js_strings|json_encode|raw }};</script>
<script src="/admin/assets/admin.js?v={{ kernel_version }}"></script>
</body>
</html>
