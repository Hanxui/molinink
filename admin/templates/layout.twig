{#
  墨林 - Molinink · 作者 Kira · https://www.molinink.com

  后台外壳(既有规范同一套数值)。
  结构、类名、内边距都照设计稿搬:整页不滚动,.content 是唯一滚动区。
  窄屏(<768px)时同一份侧栏变成抽屉,不复制第二份导航 —— 见 admin.css 的移动端段。
#}
<!doctype html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ page_title|default(__('后台')) }} · {{ site_name }}{% endblock %}</title>
    {# 站点图标(既有规范设计稿):与前台同一套根相对地址 #}
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icon/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icon/apple-touch-icon.png">
    {# 版本查询串:内核版本 + 静态文件 mtime,改过 admin.js/admin.css 也换 URL #}
    <link rel="stylesheet" href="/admin/assets/admin.css?v={{ admin_asset_version|default(kernel_version) }}">
</head>
<body>
<a class="skip" href="#content">{{ __('跳到主要内容') }}</a>
<div class="admin{% if menu is empty %} admin-bare{% endif %}">
    {% if menu is not empty %}
        <aside class="sidebar">
            <a class="brand" href="{{ site_url }}">{{ site_name }}<small>MolinInk</small></a>
            <nav class="side-nav" aria-label="{{ __('后台菜单') }}">
                {% for item in menu %}
                    {# data-icon = 类型的 menu_icon;图标能力未落地时它只是个属性,侧栏照旧画圆点 #}
                    <a href="{{ item.path }}"{% if item.active %} class="active"{% endif %}{% if item.icon is defined and item.icon %} data-icon="{{ item.icon }}"{% endif %}>
                        <span class="dot"></span><span class="label">{{ item.title }}</span>
                        {% if item.badge is defined and item.badge %}<span class="badge">{{ item.badge }}</span>{% endif %}
                    </a>
                {% endfor %}
            </nav>
            <div class="side-foot">
                <form method="post" action="{{ path('logout') }}">
                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                    <button class="out" type="submit">{{ __('退出登录') }}</button>
                </form>
                <span class="ver">v{{ kernel_version }}</span>
            </div>
        </aside>
    {% endif %}

    <div class="main">
        <header class="topbar">
            <button class="menu-btn" type="button" aria-label="{{ __('菜单') }}" aria-expanded="false">
                <span></span><span></span>
            </button>
            <a class="brand" href="{{ site_url }}">{{ site_name }}<small>MolinInk</small></a>
            <div class="site"><b>{{ site_name }}</b>　{{ site_tagline }}</div>
            <div class="right">
                <a class="visit" href="{{ site_url }}">{{ __('查看站点') }} ↗</a>
                {% if current_user %}
                    {# 头像进个人资料;退出登录挪到侧栏底部,顶栏这一格不再是退出入口 #}
                    <a class="user" href="{{ path('admin', {path: 'profile'}) }}" title="{{ __('个人资料') }}">
                        <span class="avatar"><img src="{{ avatar(current_user.email, 52) }}" alt=""></span>
                        <span class="uname">{{ current_user.display_name }}</span>
                        <span class="caret"></span>
                    </a>
                {% endif %}
            </div>
        </header>

        {# 编辑页的两条提示带要通栏、不吃内容滚动条,所以开一个口子给子模板 #}
        {% block bands %}{% endblock %}

        {# install/ 还在就常驻一条提醒(既有规范;缺的是"删掉才干净"这件事的可见性) #}
        {% if install_dir_present|default(false) %}
            <div class="admin-warn" role="status">
                <span class="k">{{ __('安全提醒') }}</span>
                <p>{{ __('安装目录还没删：请从服务器上删掉 ') }}<code>install/</code>{{ __(' 目录。留着它，别人还能打开安装页。') }}</p>
            </div>
        {% endif %}

        <div class="content-wrap">
            <div class="content" id="content" role="main">
                <div class="inner page-{{ page_kind|default('generic') }}">
                    {% block body %}{% endblock %}
                </div>
            </div>
            <div class="scrollbar"><div class="thumb"></div></div>
        </div>

        {# 固定底部的保存栏:不随内容滚动,整页仍不滚 #}
        {% block savebar %}{% endblock %}
    </div>
</div>

{# 一个遮罩两用:窄屏当抽屉背景,二次确认时当对话框的底(既有规范) #}
<div class="scrim{% if dialog_open|default(false) %} open{% endif %}">
    {% block dialog %}{% endblock %}
</div>

{# 全站唯一的一处消息提示:右下角浮窗。页面把 notice / error 交给这里统一显,
   不再各页自己往内容区顶上塞一行字(那样得先滑到顶部才看得见)。 #}
{% set toast_ok = (notice is defined and notice) ? notice : '' %}
{% set toast_err = (error is defined and error) ? error : ((notice_error is defined and notice_error) ? notice_error : '') %}
<div class="toasts" id="toasts" aria-live="polite">
    {% if toast_ok %}<div class="toast ok" role="status" data-toast-auto>{{ toast_ok }}</div>{% endif %}
    {% if toast_err %}<div class="toast err" role="alert" data-toast-auto>{{ toast_err }}</div>{% endif %}
</div>

<script>window.MOLIN_I18N = {{ js_strings|json_encode|raw }};</script>
<script src="/admin/assets/admin.js?v={{ admin_asset_version|default(kernel_version) }}"></script>
</body>
</html>
